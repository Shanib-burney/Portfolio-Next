# Public URL of the site (used for metadata). Set once a domain exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" to let search engines index the site (keep false until launch).
SITE_INDEXABLE=false

# Contact form email delivery (Resend). Without a key, messages are printed to the server log in development.
RESEND_API_KEY=
CONTACT_TO_EMAIL=shanib.burney@gmail.com
# Verified sender once a domain is set up, e.g. "Shanib Burney <hello@your-domain>".
CONTACT_FROM_EMAIL=
# "log" prints messages instead of sending them.
CONTACT_DELIVERY=
